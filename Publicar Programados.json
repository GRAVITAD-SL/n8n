    {
      "parameters": {
        "jsCode": "const sites = $node['Consolidate Sites'].json._sites;\n\nconst siteMap = {};\nfor (const site of sites) {\n  const urlRaw = site.URL;\n  const url = (Array.isArray(urlRaw) ? urlRaw[0] : urlRaw || '').toString().trim().replace(/\\/+$/, '').toLowerCase();\n  siteMap[url] = site;\n}\n\nconst result = [];\nfor (const item of items) {\n  const post = item.json;\n  const urlRaw = post['URL del sitio'];\n  const postUrl = (Array.isArray(urlRaw) ? urlRaw[0] : urlRaw || '').toString().trim().replace(/\\/+$/, '').toLowerCase();\n  const site = siteMap[postUrl];\n\n  if (!site) {\n    continue;\n  }\n\n  const userRaw = site['Usuario WP'];\n  const passRaw = site['WP password'];\n  const user = (Array.isArray(userRaw) ? userRaw[0] : userRaw || '').toString().trim();\n  const passClean = (Array.isArray(passRaw) ? passRaw[0] : passRaw || '').toString().replace(/\\s+/g, '').trim();\n  const headerAuthRaw = `Basic ${Buffer.from(`${user}:${passClean}`, 'utf8').toString('base64')}`;\n\n  result.push({\n    json: {\n      ...post,\n      headerAuthRaw\n    }\n  });\n}\n\nreturn result;"
      },
