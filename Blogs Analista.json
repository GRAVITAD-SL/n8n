    {
      "parameters": {
        "jsCode": "// Adjunta a cada web los títulos ya usados: los vivos en Posts (Airtable)\n// y los archivados en Supabase. Solo lectura: no escribe nada.\n\nconst webs = $('Webs a procesar').all().map((i) => i.json);\nconst posts = $input.all().map((i) => i.json.fields || i.json);\nconst archived = $('Títulos archivados').all().map((i) => i.json);\n\nconst normUrl = (u) => {\n  if (u === null || u === undefined) return '';\n  if (Array.isArray(u)) return u.map(normUrl).filter(Boolean)[0] || '';\n  return String(u).trim().replace(/\\/+$/, '').toLowerCase();\n};\n\nconst titlesByUrl = new Map();\nconst add = (url, tema) => {\n  const t = String(tema || '').trim();\n  if (!t || !url) return;\n  if (!titlesByUrl.has(url)) titlesByUrl.set(url, []);\n  titlesByUrl.get(url).push(t);\n};\n\nfor (const f of posts) add(normUrl(f['URL del sitio']), f['Temas']);\nfor (const row of archived) add(normUrl(row.url_sitio), row.tema);\n\nreturn webs.map((w) => {\n  const base = w.fields ? { ...w, ...w.fields } : { ...w };\n  const url = normUrl(base.URL || base['URL del sitio']);\n  const titles = [...new Set(titlesByUrl.get(url) || [])];\n  return {\n    json: {\n      ...base,\n      existingTitles: titles,\n      existingTitlesText: titles.length\n        ? titles.map((t) => '- ' + t).join('\\n')\n        : '(ninguno)',\n    },\n  };\n});"
      },
