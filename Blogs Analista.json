    {
      "parameters": {
        "jsCode": "// 1. Obtenemos los datos ORIGINALES del Trigger\nconst originalItems = $('Webs a procesar').all();\n\n// 2. Iteramos sobre las respuestas de la IA\nreturn $input.all().map((item, index) => {\n  \n  // A. Sacamos el texto que devolvió la IA\n  const rawContent = item.json.output || item.json.content || item.json.message.content;\n\n  // B. Limpiamos las etiquetas markdown\n  let cleanContent = rawContent;\n  if (rawContent && typeof rawContent === 'string') {\n      cleanContent = rawContent.replace(/```json/g, '').replace(/```/g, '');\n  }\n\n  // C. Convertimos a objeto\n  let aiData = {};\n  try {\n    aiData = JSON.parse(cleanContent);\n  } catch (error) {\n    aiData = { error: \"Error JSON IA\" };\n  }\n\n  // D. RECUPERAMOS LOS DATOS ORIGINALES\n  const original = originalItems[index] ? originalItems[index].json : {};\n  const originalFields = original.fields || original;\n\n  const originalUrl = originalFields.URL || original.URL || \"URL_NO_ENCONTRADA\";\n  const originalEstado = originalFields.Estado || original.Estado;\n\n  const originalNombreWeb = originalFields['Nombre de las webs'] || original['Nombre de las webs'];\n  const originalContexto = originalFields['Contexto de la web'] || original['Contexto de la web'];\n  const originalCategorias = originalFields['Categorías'] || original['Categorías'];\n  const originalIdioma = originalFields['Idiomas'] || original['Idiomas'];\n\n  const isYaAnadida = originalEstado === 'Añadido';\n\n  const nombre_web_final = (originalNombreWeb && String(originalNombreWeb).trim()) ? originalNombreWeb : aiData.nombre_web;\n  const contexto_final = (isYaAnadida && originalContexto) ? originalContexto : aiData.contexto;\n  const categorias_final = (isYaAnadida && originalCategorias)\n    ? originalCategorias\n    : (Array.isArray(aiData.categorias_sugeridas) ? aiData.categorias_sugeridas.join(', ') : (aiData.categorias_sugeridas || ''));\n  const idioma_final = (isYaAnadida && originalIdioma) ? originalIdioma : aiData.idioma;\n\n  return {\n    json: {\n      ...aiData,\n      URL: originalUrl,\n      nombre_web_final,\n      contexto_final,\n      categorias_final,\n      idioma_final\n    }\n  };\n});"
      },
