    {
      "parameters": {
        "jsCode": "const websAnadidas = $('Search webs añadidas').all();\nconst postsPendientes = $('Search posts pendientes').all();\n\nconst pendingWebIds = new Set();\nfor (const postItem of postsPendientes) {\n  const fields = postItem.json.fields || postItem.json;\n  const linked = fields['Web destino'] || [];\n  if (Array.isArray(linked)) {\n    for (const webId of linked) {\n      if (webId) pendingWebIds.add(webId);\n    }\n  }\n}\n\nconst elegibles = websAnadidas.filter((webItem) => {\n  const webId = webItem.json.id;\n  return webId && !pendingWebIds.has(webId);\n});\n\nreturn elegibles.map((i) => ({ json: i.json }));"
      },
